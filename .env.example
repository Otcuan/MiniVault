# Mini Vault - example environment file
#
# Copy to `.env` and adjust as needed. Every value below has a secure default,
# so Mini Vault runs correctly with no .env file at all.
#
# WHAT IS NOT HERE, ON PURPOSE:
#   - The Master Passphrase. It is typed in at /v1/vault/init and
#     /v1/vault/unlock and only ever exists in process memory. Putting it in a
#     file would defeat section 0.1: anyone reading the file could unlock the
#     Vault and decrypt every secret.
#   - The DEK, named key material and user passphrases. None of these are ever
#     configured, exported or written anywhere in plaintext.
#
# `.env` is listed in .gitignore. Never commit a real one.

# ---------------------------------------------------------------- storage paths
MINIVAULT_CONFIG_PATH=data/vault_config.json
MINIVAULT_DATABASE_PATH=data/mini_vault.db

# ------------------------------------------- Argon2id: Master Passphrase -> DEK
# Cost of deriving the wrapping key (section 0.1). Higher is slower to attack
# offline and slower to unlock. Memory cost is in KiB, so 65536 = 64 MiB.
# These are recorded in the Vault config at init time, so raising them later
# never locks an existing Vault out of its own data.
MINIVAULT_KDF_TIME_COST=3
MINIVAULT_KDF_MEMORY_COST=65536
MINIVAULT_KDF_PARALLELISM=4
MINIVAULT_KDF_HASH_LENGTH=32

# --------------------------------------------- Argon2id: user passphrase hashes
# Defaults to the KDF cost above when unset. Argon2 stores its parameters inside
# each hash, so existing accounts keep working after a change.
MINIVAULT_PASSWORD_TIME_COST=3
MINIVAULT_PASSWORD_MEMORY_COST=65536
MINIVAULT_PASSWORD_PARALLELISM=4

# ------------------------------------------------------- sessions and lockout
# Section 0.2: token lifetime, and the mandatory 5-failures / 5-minute lockout.
MINIVAULT_SESSION_TTL_MINUTES=30
MINIVAULT_MAX_FAILED_ATTEMPTS=5
MINIVAULT_LOCKOUT_MINUTES=5

# The test suite lowers the Argon2 cost parameters (see tests/conftest.py) so
# the suite finishes in seconds. Never run a real deployment with those values.
